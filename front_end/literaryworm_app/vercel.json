{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/book/:id",
      "destination": "/books/:id",
      "permanent": true
    },
    {
      "source": "/plans",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "genre",
          "value": "(?<genre>young-adult-nonfiction|literary-collections|juvenile-nonfiction|historical-fiction|literary-criticism|political-science|body-mind-spirit|foreign-language|performing-arts|social-science|transportation|language-arts|architecture|mathematics|non-fiction|photography|young-adult|house-home|philosophy|psychology|study-aids|true-crime|adventure|biography|computers|technology|education|gardening|reference|self-help|antiques|business|children|classics|religion|thriller|cooking|fantasy|fiction|history|lgbtqia|medical|mystery|romance|science|bibles|comics|crafts|design|family|health|horror|nature|poetry|sci-fi|sports|travel|drama|games|humor|music|pets|art|law)"
        }
      ],
      "destination": "/genres/:genre",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://ldzdmrdvmacpudsbngvd.supabase.co/functions/v1/mcp"
    },
    {
      "source": "/mcp/:path*",
      "destination": "https://ldzdmrdvmacpudsbngvd.supabase.co/functions/v1/mcp/:path*"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://ldzdmrdvmacpudsbngvd.supabase.co/functions/v1/mcp/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "https://ldzdmrdvmacpudsbngvd.supabase.co/functions/v1/mcp/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://ldzdmrdvmacpudsbngvd.supabase.co/functions/v1/mcp/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "https://ldzdmrdvmacpudsbngvd.supabase.co/functions/v1/mcp/.well-known/oauth-authorization-server"
    },
    {
      "source": "/texts/:file",
      "destination": "https://ldzdmrdvmacpudsbngvd.supabase.co/storage/v1/object/public/book-texts/:file"
    },
    {
      "source": "/:page(pricing|signin|signup|reset-password|whats-new|affiliates|unsubscribe|search|profiles|gifts|browse|library|account|dashboard|support|maintenance)",
      "destination": "/shell"
    },
    {
      "source": "/:section(legal|books|authors|narrators|clips|readers|lists|clubs|read|listen)/:id",
      "destination": "/shell"
    },
    {
      "source": "/clubs/join/:code",
      "destination": "/shell"
    },
    {
      "source": "/oauth/consent",
      "destination": "/shell"
    },
    {
      "source": "/affiliates/review",
      "destination": "/shell"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.literaryworm.com/>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/:page(pricing|whats-new|search|signup|affiliates)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.literaryworm.com/:page>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/:section(books|authors|narrators|readers)/:name([A-Za-z0-9_.~%-]+)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.literaryworm.com/:section/:name>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/:page(signin|reset-password|unsubscribe|profiles|gifts|browse|library|account|dashboard|support|maintenance)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/:section(read|listen|clubs|lists|clips|oauth)/:rest*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/affiliates/review",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/search",
      "has": [
        {
          "type": "query",
          "key": "q"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/search",
      "has": [
        {
          "type": "query",
          "key": "by"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/search",
      "has": [
        {
          "type": "query",
          "key": "genre"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/search",
      "has": [
        {
          "type": "query",
          "key": "sort"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/search",
      "has": [
        {
          "type": "query",
          "key": "source"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/search",
      "has": [
        {
          "type": "query",
          "key": "lang"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/search",
      "has": [
        {
          "type": "query",
          "key": "length"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
