{
  "redirects": [
    {
      "source": "/book/:id",
      "destination": "/books/:id",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/texts/:file",
      "destination": "https://ldzdmrdvmacpudsbngvd.supabase.co/storage/v1/object/public/book-texts/:file"
    },
    {
      "source": "/((?!\\.well-known/)(?!.*\\.(?:json|txt|xml|mp3|png|jpe?g|webp|gif|svg|ico|js|mjs|css|map|webmanifest|pdf|woff2?|ttf)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.literaryworm.com/>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/:page(plans|whats-new|search|signup|signin|affiliates)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.literaryworm.com/:page>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/:section(books|series|authors|narrators|legal|readers)/:name",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.literaryworm.com/:section/:name>; rel=\"canonical\""
        }
      ]
    }
  ]
}
